{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@accounting/ui": ["../../packages/ui/src"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/**/*.d.ts",
    "../../packages/ui/src/**/*"
  ]
}
