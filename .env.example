# Copy to .env. Never commit the real thing.

ACCOUNTING_DEPLOYMENT_MODE=local
ACCOUNTING_DATABASE_URL=postgresql://accounting:accounting@localhost:5432/accounting

# Connection used ONLY for model-generated text-to-SQL. Authenticates as the
# read-only `nl_query` role from db/roles.sql. Required in server mode: the API
# refuses to run generated SQL as the application role against a multi-tenant
# database.
# ACCOUNTING_NL_QUERY_DATABASE_URL=postgresql://nl_query:CHANGEME@localhost:5432/accounting

# Connection used ONLY to create a workspace. Authenticates as the table
# owner (accounting_app cannot: there is no workspace yet for row-level
# security to scope the session to). Required for POST /workspaces to work
# at all -- see db/README.md, "Creating a workspace cannot happen through
# the app connection".
# ACCOUNTING_PROVISIONING_DATABASE_URL=postgresql://accounting:CHANGEME@localhost:5432/accounting

ACCOUNTING_LOG_LEVEL=INFO
